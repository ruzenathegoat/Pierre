# ~/.hermes/.env — Hermes Agent Core Secrets
# LLM Providers:
# Primary: OpenAI OAuth (openai-codex); hermes auth add openai-codex --type oauth
# Fallback: Anthropic OAuth (claude-subscription-directsdk-experimental); claude auth login
# Optional OpenRouter profile (only used when explicitly selected):
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY

# Discord Bot Gateway
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_ALLOWED_USERS=YOUR_DISCORD_USER_ID



# GitHub fine-grained token (Contents: Read and write, repo Pierre only)
GITHUB_TOKEN=github_pat_YOUR_TOKEN_HERE
